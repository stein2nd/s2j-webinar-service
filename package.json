{
    "name": "s2j-webinar-service",
    "version": "0.1.2",
    "private": true,
    "description": "A pure PHP library for building a Webinar Request (WP-Independent)",
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stein2nd/s2j-webinar-service.git"
    },
    "homepage": "https://github.com/stein2nd/s2j-webinar-service#readme",
    "bugs": {
        "url": "https://github.com/stein2nd/s2j-webinar-service/issues"
    },
    "keywords": [
        "php",
        "library",
        "webinar",
        "wordpress",
        "gatherpress"
    ],
    "devDependencies": {
        "@s2j/docs-linter": "^1.0.29"
    },
    "scripts": {
        "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
        "lint:php": "composer lint:php",
        "phpstan": "composer phpstan",
        "phpcs": "composer phpcs",
        "test": "composer test",
        "validate:composer": "composer validate-composer",
        "verify:dist": "composer verify-dist",
        "quality": "bash scripts/verify/all.sh",
        "pretest:unit:php:local": "composer install --no-interaction --prefer-dist",
        "test:unit:php:local": "composer test",
        "pretest:lint:php": "composer install --no-interaction --prefer-dist"
    },
    "allowScripts": {
        "@s2j/docs-linter": true
    }
}
