{
    "name": "s2j/webinar-service",
    "description": "A pure PHP library for building a Webinar Request (WP-Independent)",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/stein2nd/s2j-webinar-service#readme",
    "support": {
        "issues": "https://github.com/stein2nd/s2j-webinar-service/issues",
        "source": "https://github.com/stein2nd/s2j-webinar-service"
    },
    "authors": [
        {
            "name": "Koutarou ISHIKAWA"
        }
    ],
    "keywords": [
        "webinar",
        "wordpress",
        "gatherpress"
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "S2J\\WebinarService\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "S2J\\WebinarService\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs -n",
        "validate-composer": "composer validate --strict",
        "verify-dist": "bash scripts/verify-composer-dist.sh",
        "phpcbf": "@php vendor/bin/phpcbf",
        "lint:php": [
            "@phpstan",
            "@phpcs"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
